# ================= 配置模板 =================
# 用法：把本文件复制为同目录下的 .env，然后填入自己的 Key。
#   Windows:      copy backend\.env.example backend\.env
#   macOS/Linux:  cp backend/.env.example backend/.env
# .env 已被 .gitignore 忽略，不会误提交。
# ============================================

# ---------- 必填 ----------
# DeepSeek 大模型 API Key（申请地址 https://platform.deepseek.com/）
# 目标精炼、技能差距识别、学习路径规划、内容生成、测验、AI 导师全部依赖它
DEEPSEEK_API_KEY=

# ---------- 可选：配图生成（豆包 / 火山引擎 Seedream）----------
# 不填也能正常使用，只是配图会回退到必应图片搜索
# VOLCENGINE_API_KEY 填火山方舟控制台「API Key 管理」里的明文 Key（不要加引号、不要编码）
# 注意：还需在控制台「开通管理」里激活所用的图像模型，否则会报 ModelNotOpen
VOLCENGINE_API_KEY=
DOUBAO_IMAGE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 图像模型 id（用 GET https://ark.cn-beijing.volces.com/api/v3/models 可查账号可用模型）
# 例：doubao-seedream-5-0-flash-260915 / doubao-seedream-4-0-20260415
DOUBAO_IMAGE_MODEL=doubao-seedream-5-0-flash-260915

# ---------- 可选：其他搜索 / 模型后端 ----------
# 本项目默认使用 cn.bing.com 网页搜索（bing_cn），无需任何 Key，以下均可不填
OPENAI_API_KEY=
TOGETHER_API_KEY=
SERPER_API_KEY=
BRAVE_API_KEY=
BING_SUBSCRIPTION_KEY=
BING_SEARCH_URL=
